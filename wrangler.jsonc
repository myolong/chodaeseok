// Cloudflare Workers 배포 설정: public/ 은 정적 화면, /api/* 와 /stats 는 워커가 받아 Durable Object(SQLite)에 저장
{
  "name": "chodaeseok",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/stats", "/admin"]
  },
  "durable_objects": { "bindings": [{ "name": "DB", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }]
}
